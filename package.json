{
  "name": "@doeixd/discern",
  "version": "0.4.0",
  "description": "Uncertainty-aware semantic control flow for Effect: type-safe patterns, policies and routable procedures over DecisionModel.",
  "license": "MIT",
  "author": "Patrick Glenn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doeixd/discern.git"
  },
  "homepage": "https://github.com/doeixd/discern#readme",
  "bugs": {
    "url": "https://github.com/doeixd/discern/issues"
  },
  "keywords": [
    "effect",
    "effect-ts",
    "decision-model",
    "pattern-matching",
    "llm",
    "ai",
    "uncertainty",
    "classification",
    "control-flow",
    "semantic-routing",
    "jev",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./procedure": {
      "types": "./dist/procedure.d.ts",
      "import": "./dist/procedure.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test test/index.test.mjs test/procedure.test.mjs",
    "test:types": "tsc --noEmit --strict --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck test/types.ts test/integration.types.ts examples/headline.ts examples/comparison.ts",
    "check": "npm run typecheck && npm run test:types && npm test",
    "example": "npm run build && node examples/walkthrough.mjs",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@effect/ai-typesafe": "^4.0.0-rc.117",
    "effect": "4.0.0-rc.117",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-rc.116 <5"
  },
  "engines": {
    "node": ">=20"
  }
}
