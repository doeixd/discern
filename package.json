{
  "name": "discern",
  "version": "0.2.0",
  "description": "Uncertainty-aware semantic pattern matching, tracing and evaluation for Effect DecisionModel.",
  "license": "MIT",
  "author": "Patrick Glenn",
  "repository": { "type": "git", "url": "git+https://github.com/doeixd/discern.git" },
  "homepage": "https://github.com/doeixd/discern#readme",
  "bugs": { "url": "https://github.com/doeixd/discern/issues" },
  "keywords": [
    "effect",
    "effect-ts",
    "decision-model",
    "pattern-matching",
    "llm",
    "ai",
    "uncertainty",
    "classification",
    "control-flow",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./capability": {
      "types": "./dist/capability.d.ts",
      "import": "./dist/capability.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test test/index.test.mjs test/capability.test.mjs",
    "test:types": "tsc --noEmit --strict --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck test/types.ts",
    "check": "npm run typecheck && npm run test:types && npm test"
  },
  "devDependencies": {
    "effect": "4.0.0-rc.117",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-rc.116 <5"
  },
  "engines": { "node": ">=20" }
}
